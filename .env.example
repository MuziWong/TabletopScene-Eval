# Copy this file to a private .env file; never commit your real key.
# Required only when metrics.gpt_evaluation.enabled is true.
OPENAI_API_KEY=replace_with_your_api_key

# Optional for an OpenAI-compatible gateway; remove to use the SDK default.
# OPENAI_BASE_URL=https://your-gateway.example/v1

# Model used unless metrics.gpt_evaluation.options.model explicitly overrides it.
OPENAI_MODEL=gpt-5

# Optional local caches for LPIPS/PyTorch and DINOv2/CLIP/Hugging Face.
# TORCH_HOME=/absolute/path/to/torch-cache
# HF_HOME=/absolute/path/to/huggingface-cache
